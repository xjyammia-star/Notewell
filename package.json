{
  "name": "notewell",
  "version": "1.0.5",
  "description": "Notewell — Student Knowledge Base",
  "author": "xjyammia-star",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.notewell.app",
    "productName": "Notewell",
    "icon": "assets/icon",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "artifactName": "notewell.dmg"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "artifactName": "notewell-setup.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "xjyammia-star",
      "repo": "Notewell",
      "releaseType": "release"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "sharp": "^0.35.3"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "chokidar": "^3.5.3",
    "docx": "^9.7.1",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.9",
    "jsdom": "^24.1.3",
    "katex": "^0.18.5",
    "mammoth": "^1.12.2",
    "pdf-parse": "^1.1.1"
  },
  "allowScripts": {
    "electron@28.3.3": true,
    "fsevents@2.3.3": true
  }
}
